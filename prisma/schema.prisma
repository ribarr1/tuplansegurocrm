// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Migración 001 — Core Identity
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  AGENT
  ASSISTANT
}

enum ContactStatus {
  PROSPECT
  CLIENT
  FORMER_CLIENT
  OTHER
}

enum HouseholdMemberRole {
  HEAD
  SPOUSE
  CHILD
  DEPENDENT
  OTHER
}

enum PolicyType {
  HEALTH
  LIFE
  SUPPLEMENTAL
  DENTAL
  FINAL_EXPENSE
}

// Usuario/agente interno. Identidad de negocio (role, isActive) vive
// aquí; credenciales (password) y sesiones viven en Account/Session
// (Better Auth), separadas de este modelo. emailVerified/image son
// campos técnicos requeridos por Better Auth, sin uso de negocio.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(AGENT)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedPeople                   Person[]                @relation("PersonAssignedAgent")
  processedPolicies                Policy[]                @relation("PolicyProcessedBy")
  assignedTasks                    Task[]                  @relation("TaskAssignedTo")
  createdTasks                     Task[]                  @relation("TaskCreatedBy")
  createdNotes                     Note[]                  @relation("NoteCreatedBy")
  commissionExpectations           CommissionExpectation[]
  overriddenCommissionExpectations CommissionExpectation[] @relation("CommissionExpectationOverriddenBy")
  uploadedDocuments                PolicyDocument[]
  sessions                         Session[]
  accounts                         Account[]

  @@map("users")
}

// Identidad central. Nunca se duplica al pasar de prospecto a cliente:
// el cambio se refleja en contactStatus.
model Person {
  id              String        @id @default(uuid()) @db.Uuid
  firstName       String
  middleName      String?
  lastName        String
  secondLastName  String?
  preferredName   String?
  dateOfBirth     DateTime?     @db.Date
  email           String?
  phone           String?
  contactStatus   ContactStatus @default(PROSPECT)
  source          String?
  assignedAgentId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedAgent     User?              @relation("PersonAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  householdMembers  HouseholdMember[]
  holderPolicies    Policy[]           @relation("PolicyHolder")
  policyMemberships PolicyMember[]     @relation("PolicyMemberPerson")
  tasks             Task[]
  notes             Note[]
  birthdayGreetings BirthdayGreeting[]
  providers         PersonProvider[]
  medications       PersonMedication[]

  @@index([lastName])
  @@index([phone])
  @@index([email])
  @@index([assignedAgentId])
  @@map("people")
}

// Agrupación de personas en un hogar/familia. Una persona puede
// pertenecer a más de un hogar (N:M vía HouseholdMember).
// Dirección y datos financieros del hogar — Fase 019.5. La dirección
// principal vive aquí (no en Person) porque normalmente corresponde al
// hogar asegurado completo, no a un individuo — evita duplicarla por
// cada miembro. Una Person con dirección propia distinta del hogar
// queda deliberadamente fuera de alcance en V1 (no existe ese campo en
// Person todavía); esta decisión no cierra esa posibilidad futura, ver
// docs/DECISIONS.md.
model Household {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?  @db.VarChar(2)
  zipCode               String?
  county                String?
  // Ingreso familiar general y actual del hogar — DISTINTO de
  // HealthPolicyDetail.incomeUsed (el ingreso declarado en una
  // aplicación/póliza Marketplace específica). Nunca deben confundirse
  // ni sincronizarse automáticamente entre sí, ver docs/DECISIONS.md.
  annualHouseholdIncome Decimal? @db.Decimal(12, 2)
  incomeYear            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members  HouseholdMember[]
  policies Policy[]

  @@map("households")
}

// Tabla intermedia Person <-> Household, con el rol de la persona
// dentro de ese hogar.
model HouseholdMember {
  id          String              @id @default(uuid()) @db.Uuid
  personId    String              @db.Uuid
  householdId String              @db.Uuid
  role        HouseholdMemberRole
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([personId, householdId])
  @@index([householdId])
  @@map("household_members")
}

// Aseguradora. Administrable como dato, nunca hardcodeada en código.
model Carrier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("carriers")
}

// Producto/plan ofrecido por un carrier. Fuente de verdad del tipo de
// seguro y del carrier de una póliza (Policy no duplica estos datos).
model Product {
  id           String     @id @default(uuid()) @db.Uuid
  carrierId    String     @db.Uuid
  name         String
  policyType   PolicyType
  planYear     Int?
  externalCode String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  carrier         Carrier          @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  policies        Policy[]
  commissionRules CommissionRule[]

  @@index([carrierId, policyType, planYear])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Migración 002 — Policies
// ---------------------------------------------------------------------------

// "Renovada" NO es un valor de este enum: es derivable de la relación
// previousPolicyId (renewedInto != null en la póliza anterior). Ver
// docs/DECISIONS.md — evita dos fuentes de verdad para el mismo hecho.
enum PolicyStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PolicyOperationType {
  NEW_ENROLLMENT
  RENEWAL
  PLAN_CHANGE
}

enum PolicyMemberRole {
  PRIMARY
  SPOUSE
  DEPENDENT
  OTHER
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  OTHER
}

// Fase 019.5. Vive en Policy (no en Product) porque un mismo Carrier —
// e incluso un mismo Product — puede en principio emitirse por
// Marketplace o de forma privada; la clasificación real corresponde a
// la póliza/enrollment concreto, no al catálogo. Nunca se infiere por
// el nombre del carrier — ver docs/DECISIONS.md.
enum HealthCoverageSource {
  MARKETPLACE
  PRIVATE
}

enum PaymentStatus {
  CURRENT
  DUE
  PAST_DUE
}

// Póliza emitida y su historial. No duplica carrier ni policyType: se
// derivan siempre vía product -> carrier. Las renovaciones crean una
// nueva Policy encadenada mediante previousPolicyId; nunca se sobrescribe
// una póliza histórica. CHECK (id <> previousPolicyId) a nivel DB impide
// que una póliza se marque como renovación de sí misma; ciclos de más de
// un nivel (A -> B -> A) se validan en aplicación, no en DB.
model Policy {
  id                     String                @id @default(uuid()) @db.Uuid
  holderId               String                @db.Uuid
  householdId            String?               @db.Uuid
  productId              String                @db.Uuid
  policyNumber           String?
  status                 PolicyStatus          @default(PENDING)
  // Nullable: una póliza PENDING puede existir antes de conocer su fecha
  // efectiva definitiva. Regla de aplicación (no DB): requerida cuando
  // status = ACTIVE.
  effectiveDate          DateTime?             @db.Date
  terminationDate        DateTime?             @db.Date
  previousPolicyId       String?               @unique @db.Uuid
  processedById          String?               @db.Uuid
  premiumAmount          Decimal?              @db.Decimal(12, 2)
  billingFrequency       BillingFrequency?
  nextPaymentDueDate     DateTime?             @db.Date
  autopay                Boolean               @default(false)
  needsPaymentAssistance Boolean               @default(false)
  paymentStatus          PaymentStatus?
  operationType          PolicyOperationType?
  // Solo tiene sentido para policyType HEALTH (vía product.policyType) —
  // regla de aplicación, no constraint de DB, mismo patrón que el resto
  // de reglas cruzadas de Policy. Null en pólizas no-HEALTH o cuando
  // todavía no se ha clasificado.
  healthCoverageSource   HealthCoverageSource?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  holder                 Person                  @relation("PolicyHolder", fields: [holderId], references: [id], onDelete: Restrict)
  household              Household?              @relation(fields: [householdId], references: [id], onDelete: SetNull)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  processedBy            User?                   @relation("PolicyProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  previousPolicy         Policy?                 @relation("PolicyRenewal", fields: [previousPolicyId], references: [id], onDelete: Restrict)
  renewedInto            Policy?                 @relation("PolicyRenewal")
  members                PolicyMember[]
  healthDetail           HealthPolicyDetail?
  tasks                  Task[]
  notes                  Note[]
  commissionExpectations CommissionExpectation[]
  documents              PolicyDocument[]
  commissionRules        CommissionRule[]

  @@index([holderId])
  @@index([productId])
  @@index([status])
  @@index([effectiveDate])
  @@index([policyNumber])
  @@index([householdId])
  @@map("policies")
}

// Cobertura efectiva de una póliza emitida. Una fila = una persona
// realmente cubierta. Si el titular está cubierto, también debe tener
// fila aquí (role = PRIMARY): PolicyMember es siempre la fuente de
// verdad de cobertura, nunca se infiere a partir de Policy.holderId.
// Personas evaluadas/excluidas durante cotización pertenecerán a una
// futura Application/Quote, no a esta tabla. Índice único parcial en DB
// garantiza como máximo un PRIMARY por póliza; que ese PRIMARY coincida
// con Policy.holderId se valida en aplicación (requeriría trigger
// cross-tabla en DB, desproporcionado para esta fase).
model PolicyMember {
  id        String           @id @default(uuid()) @db.Uuid
  policyId  String           @db.Uuid
  personId  String           @db.Uuid
  role      PolicyMemberRole
  createdAt DateTime         @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  person Person @relation("PolicyMemberPerson", fields: [personId], references: [id], onDelete: Restrict)

  @@unique([policyId, personId])
  @@index([personId])
  @@map("policy_members")
}

// Extensión 1:1 de Policy solo para pólizas de salud (Policy.product
// con policyType = HEALTH). Esa regla se valida en la aplicación, no
// mediante trigger de base de datos. planNameSnapshot conserva el
// nombre del plan al momento de la póliza, porque el catálogo Product
// es mutable y el historial de la póliza no debe cambiar si el
// catálogo se renombra o desactiva después.
model HealthPolicyDetail {
  id                       String   @id @default(uuid()) @db.Uuid
  policyId                 String   @unique @db.Uuid
  marketplaceApplicationId String?
  marketplaceState         String?  @db.VarChar(2)
  planNameSnapshot         String?
  taxCreditAmount          Decimal? @db.Decimal(12, 2)
  incomeUsed               Decimal? @db.Decimal(12, 2)
  deductibleIndividual     Decimal? @db.Decimal(12, 2)
  deductibleFamily         Decimal? @db.Decimal(12, 2)
  outOfPocketIndividual    Decimal? @db.Decimal(12, 2)
  outOfPocketFamily        Decimal? @db.Decimal(12, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([marketplaceApplicationId])
  @@map("health_policy_details")
}

// ---------------------------------------------------------------------------
// Fase 019.5 — Documentos de Policy
// ---------------------------------------------------------------------------

enum PolicyDocumentType {
  PLAN_SUMMARY
  BROCHURE
  FORMULARY
  PROVIDER_DIRECTORY
  MEMBER_CARD
  APPLICATION
  OTHER
}

// Metadata únicamente — el archivo binario nunca vive en PostgreSQL.
// storageKey es un identificador GENERADO (nunca el nombre original del
// archivo ni una ruta derivada de input del usuario) — ver
// src/lib/storage.ts. fileName se conserva solo como metadata para
// mostrar en la UI, nunca se usa para resolver la ubicación real del
// archivo (evita path traversal).
model PolicyDocument {
  id           String             @id @default(uuid()) @db.Uuid
  policyId     String             @db.Uuid
  type         PolicyDocumentType
  fileName     String
  storageKey   String             @unique
  mimeType     String
  fileSize     Int
  description  String?
  uploadedById String?            @db.Uuid
  createdAt    DateTime           @default(now())

  policy     Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@map("policy_documents")
}

// ---------------------------------------------------------------------------
// Fase 019.5 — Reglas de comisión
// ---------------------------------------------------------------------------

enum CommissionMethod {
  FIXED_AMOUNT
  PERCENTAGE
}

// Sobre qué se calcula el monto/porcentaje — ver docs/DECISIONS.md para
// el análisis de los 4 casos reales que este enum debe cubrir (monto
// fijo por póliza, monto fijo por miembro, % de prima anualizada, %
// residual anual).
enum CommissionBase {
  PREMIUM_MONTHLY
  PREMIUM_ANNUALIZED
  PER_MEMBER
  FIXED
  OTHER
}

enum CommissionPeriodicity {
  ONE_TIME
  MONTHLY
  ANNUAL
}

// Configuración de CÓMO se genera una CommissionExpectation — vive a
// nivel Product (policyId = null, aplica a todas las pólizas de ese
// producto) con posibilidad de override específico por Policy
// (policyId no nulo). Nunca se copia esta configuración a cada póliza
// manualmente cuando es idéntica — ver docs/DECISIONS.md.
//
// Cambiar una regla NUNCA reescribe CommissionExpectation ya generadas
// — solo afecta generaciones futuras (commission-rules.service.ts).
model CommissionRule {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  policyId  String? @db.Uuid

  method             CommissionMethod
  base               CommissionBase
  // Método FIXED_AMOUNT: initialAmount es el monto. Método PERCENTAGE:
  // initialPercentage es el porcentaje (80.00 = 80%). Solo uno de los
  // dos aplica según "method" — validado en la aplicación, no en DB.
  initialAmount      Decimal?              @db.Decimal(12, 2)
  initialPercentage  Decimal?              @db.Decimal(5, 2)
  initialPeriodicity CommissionPeriodicity

  residualEnabled     Boolean                @default(false)
  residualAmount      Decimal?               @db.Decimal(12, 2)
  residualPercentage  Decimal?               @db.Decimal(5, 2)
  residualPeriodicity CommissionPeriodicity?
  // Año de póliza (1 = primer año) desde el cual aplica el residual.
  residualStartYear   Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product               Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  policy                Policy?                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  generatedExpectations CommissionExpectation[]

  @@index([productId])
  @@index([policyId])
  @@map("commission_rules")
}

// ---------------------------------------------------------------------------
// Migración 003 — Operations
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BirthdayGreetingStatus {
  PENDING
  SENT
  SKIPPED
}

enum BirthdayGreetingChannel {
  WHATSAPP
  SMS
  EMAIL
  OTHER
}

// Trabajo operativo pendiente o completado. Se relaciona con Person/Policy
// mediante FKs explícitas y opcionales, sin polimorfismo (entityType/entityId).
// "Vencida" es un estado derivado (status activo + dueAt < now) y
// deliberadamente no se almacena como valor de TaskStatus.
model Task {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  completedAt  DateTime?
  personId     String?      @db.Uuid
  policyId     String?      @db.Uuid
  assignedToId String?      @db.Uuid
  createdById  String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  person     Person? @relation(fields: [personId], references: [id], onDelete: Restrict)
  policy     Policy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  assignedTo User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([personId])
  @@index([policyId])
  @@map("tasks")
}

// Nota operativa/histórica en texto plano, ligada a una persona y/o
// póliza (al menos una, nunca ninguna: CHECK en DB). No es un sustituto
// de AuditLog (cambios estructurados del sistema): eso será una entidad
// futura separada.
model Note {
  id          String   @id @default(uuid()) @db.Uuid
  content     String
  personId    String?  @db.Uuid
  policyId    String?  @db.Uuid
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person    Person? @relation(fields: [personId], references: [id], onDelete: Restrict)
  policy    Policy? @relation(fields: [policyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([policyId])
  @@map("notes")
}

// Gestión de la tarjeta de cumpleaños de una persona en un año
// específico. Person.dateOfBirth sigue siendo la única fuente de la
// fecha de nacimiento; esta tabla no la duplica. La ausencia de una
// fila para (personId, año actual) se interpreta como "aún no
// gestionado" — no se crean filas automáticamente para todas las
// personas cada enero, solo cuando el flujo de trabajo interactúa
// con ese cumpleaños. CHECKs en DB garantizan: SENT siempre tiene
// channel y sentAt; PENDING/SKIPPED nunca tienen sentAt.
model BirthdayGreeting {
  id        String                   @id @default(uuid()) @db.Uuid
  personId  String                   @db.Uuid
  year      Int
  status    BirthdayGreetingStatus   @default(PENDING)
  channel   BirthdayGreetingChannel?
  sentAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([personId, year])
  @@index([year, status])
  @@map("birthday_greetings")
}

// ---------------------------------------------------------------------------
// Migración 004 — Financial
// ---------------------------------------------------------------------------

enum CommissionExpectationStatus {
  ACTIVE
  CANCELLED
}

enum CommissionPaymentType {
  PAYMENT
  CHARGEBACK
  ADJUSTMENT
}

// Cuánto esperamos recibir por una póliza en un período (mes) determinado.
// No almacena carrier: se deriva vía policy -> product -> carrier. status
// es un hecho de negocio propio (¿seguimos esperando este dinero?), no
// derivado de los pagos — PARTIAL/PAID/UNPAID se calculan siempre a partir
// de SUM(CommissionPayment.amount) vs expectedAmount, nunca se almacenan.
model CommissionExpectation {
  id                String                      @id @default(uuid()) @db.Uuid
  policyId          String                      @db.Uuid
  agentId           String?                     @db.Uuid
  // Primer día del mes de comisión (convención): 2026-08-01 = agosto 2026.
  period            DateTime                    @db.Date
  // Monto final que se usa en toda la aplicación (reportes, Dashboard,
  // conciliación con CommissionPayment) — puede ser igual a
  // calculatedAmount o haber sido corregido manualmente por ADMIN.
  expectedAmount    Decimal                     @db.Decimal(12, 2)
  // Fase 019.7: monto que produjo CommissionRule al generar esta fila —
  // null si la expectativa se creó a mano (flujo Fase 016, sin regla).
  // Se conserva SIEMPRE tal como se calculó, incluso si expectedAmount
  // se corrige después — es el punto de comparación "calculado vs
  // esperado final" que pide la UI, nunca se recalcula retroactivamente.
  calculatedAmount  Decimal?                    @db.Decimal(12, 2)
  generatedByRuleId String?                     @db.Uuid
  isManualOverride  Boolean                     @default(false)
  overriddenById    String?                     @db.Uuid
  overriddenAt      DateTime?
  overrideReason    String?
  status            CommissionExpectationStatus @default(ACTIVE)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  policy          Policy              @relation(fields: [policyId], references: [id], onDelete: Restrict)
  agent           User?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  generatedByRule CommissionRule?     @relation(fields: [generatedByRuleId], references: [id], onDelete: SetNull)
  overriddenBy    User?               @relation("CommissionExpectationOverriddenBy", fields: [overriddenById], references: [id], onDelete: SetNull)
  payments        CommissionPayment[]

  @@unique([policyId, period])
  @@index([period])
  @@index([agentId, period])
  @@index([generatedByRuleId])
  @@map("commission_expectations")
}

// Movimiento real contra una expectativa: pago, chargeback o ajuste.
// amount puede ser positivo o negativo; la coherencia entre type y el
// signo de amount se valida en la aplicación, no mediante CHECK en la
// base de datos. Un chargeback es simplemente un CommissionPayment con
// amount negativo y type = CHARGEBACK — no existe una tabla separada.
// Los pagos nunca se editan ni se borran: cada ajuste es una fila nueva.
model CommissionPayment {
  id                      String                @id @default(uuid()) @db.Uuid
  commissionExpectationId String                @db.Uuid
  amount                  Decimal               @db.Decimal(12, 2)
  type                    CommissionPaymentType
  receivedAt              DateTime
  externalReference       String?
  notes                   String?
  createdAt               DateTime              @default(now())

  commissionExpectation CommissionExpectation @relation(fields: [commissionExpectationId], references: [id], onDelete: Restrict)

  @@index([commissionExpectationId])
  @@index([receivedAt])
  @@map("commission_payments")
}

// ---------------------------------------------------------------------------
// Migración 005 — Health Operational Data
// ---------------------------------------------------------------------------

enum ProviderType {
  PCP
  SPECIALIST
  OTHER
}

// Médico/proveedor conocido asociado a una persona. Información
// operativa mínima para atender al cliente (a quién contactar, con
// quién coordinar) — NO es un sistema clínico. notes es de uso
// estrictamente operativo (ej. preferencias de horario, cambios de
// contacto); nunca debe usarse para diagnósticos, condiciones o
// historia médica. Ver docs/SECURITY.md sobre control de acceso.
model PersonProvider {
  id           String       @id @default(uuid()) @db.Uuid
  personId     String       @db.Uuid
  type         ProviderType
  name         String
  specialty    String?
  phone        String?
  organization String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_providers")
}

// Medicamento informado por el cliente, relevante para su operación
// de seguros. Mismo alcance operativo limitado que PersonProvider:
// no diagnósticos, no condiciones, no narrativa clínica. isActive
// permite discontinuar un medicamento conservando su historial, en
// vez de borrar la fila.
model PersonMedication {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @db.Uuid
  name      String
  dosage    String?
  frequency String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([personId, isActive])
  @@map("person_medications")
}

// ---------------------------------------------------------------------------
// Migración 007 — Auth Foundation
// ---------------------------------------------------------------------------
// Tablas técnicas de Better Auth. Deliberadamente separadas del modelo de
// negocio (User conserva role/isActive como fuente de autorización).
// Nombres en minúscula singular (user/session/account/verification son la
// convención de Better Auth) para distinguirlas a simple vista de las
// tablas de negocio en snake_case plural del resto del esquema.

// Sesión de login activa. Respaldada por base de datos (no JWT-only):
// permite revocar acceso en tiempo real cuando User.isActive pasa a false,
// sin esperar a que expire un token firmado.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Credencial de login (email+password) u otro proveedor futuro. El
// password hasheado vive aquí, NUNCA en User — separación recomendada
// por Better Auth. accessToken/refreshToken/idToken/scope quedan sin
// uso mientras no se agregue login social (fuera de alcance de esta fase).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  // Identifica el proveedor de login concreto (ej. "local:credential"
  // para email+password). Requerido por Better Auth 1.7; distingue
  // cuentas del mismo providerId emitidas por distintos orígenes.
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

// Tokens de un solo uso (verificación de email, reset de password).
// No se usa todavía en esta fase (sin proveedor de email configurado),
// pero la tabla ya existe para cuando se agregue esa funcionalidad sin
// requerir otra migración.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
