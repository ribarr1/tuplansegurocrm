{
  "info": {
    "name": "Fábrica de Leads — Recepción (Fase 026)",
    "description": "Casos mínimos de prueba local para POST /api/leads/intake. Reemplaza {{webAuthorization}}/{{googleAuthorization}} con el valor real generado en /settings/lead-credentials (nunca el de este archivo, que no contiene secretos reales). Las operaciones internas (asignar, convertir, cerrar, actividades, contadores) usan sesión de usuario autenticada por cookie (Better Auth) y Server Actions de Next.js, no esta API — se prueban desde la aplicación y con las pruebas automatizadas de src/services/leads.service.test.ts, no con Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Lead nuevo — WEB",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{webAuthorization}}" }
        ],
        "url": "{{baseUrl}}/api/leads/intake",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"María Pérez\",\n  \"phone\": \"3051234567\",\n  \"email\": \"maria@example.com\",\n  \"residenceState\": \"FL\",\n  \"productInterest\": \"HEALTH\",\n  \"externalId\": \"web-form-0001\",\n  \"campaignId\": \"spring-2026\",\n  \"campaignName\": \"Campaña de primavera\",\n  \"originalInquiryAt\": \"2026-09-30T14:00:00.000Z\",\n  \"consentGiven\": true,\n  \"consentText\": \"Acepto ser contactado por TuPlanSeguro USA.\",\n  \"consentSource\": \"checkbox del formulario\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"stage = LEAD, followUpStatus = NEW\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.stage).to.eql('LEAD');",
              "  pm.expect(body.followUpStatus).to.eql('NEW');",
              "  pm.expect(body.duplicate).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
