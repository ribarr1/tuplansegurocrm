# Copia este archivo a .env y ajusta los valores para tu entorno local.
# .env está excluido de Git (ver .gitignore). Nunca versionar credenciales reales.

# PostgreSQL (desarrollo local via Docker Compose)
POSTGRES_DB=tuplanseguro_crm
POSTGRES_USER=crm_dev_user
POSTGRES_PASSWORD=change_me_dev_only
# 5433 en lugar del puerto default 5432 para evitar choques con otro
# PostgreSQL que puedas tener corriendo localmente (Docker u otro proyecto).
POSTGRES_PORT=5433

# Cadena de conexión que usa Prisma. Debe coincidir con las variables de
# arriba (mismo usuario, password, puerto y nombre de base de datos).
DATABASE_URL="postgresql://crm_dev_user:change_me_dev_only@localhost:5433/tuplanseguro_crm?schema=public"

# Better Auth. Genera el tuyo con: npx @better-auth/cli secret
# Nunca reutilices este valor de ejemplo en un entorno real.
BETTER_AUTH_SECRET=replace_with_your_own_generated_secret
BETTER_AUTH_URL=http://localhost:3000

# Zona horaria de negocio (identificador IANA, ej. "America/Chicago",
# "America/New_York"). Usada para calcular "hoy"/"este mes" en Tareas y
# Cumpleaños de forma consistente sin importar en qué zona horaria
# corre el servidor. Requerida — si falta o es inválida, la aplicación
# falla de forma clara al usarla en vez de adivinar (ver
# src/lib/business-time.ts). TuPlanSeguro USA opera en una sola zona
# horaria en V1 (sin soporte multi-timezone por usuario).
APP_TIME_ZONE=America/Chicago
