# Copia este archivo a .env y ajusta los valores para tu entorno local.
# .env está excluido de Git (ver .gitignore). Nunca versionar credenciales reales.

# PostgreSQL (desarrollo local via Docker Compose)
POSTGRES_DB=tuplanseguro_crm
POSTGRES_USER=crm_dev_user
POSTGRES_PASSWORD=change_me_dev_only
# 5433 en lugar del puerto default 5432 para evitar choques con otro
# PostgreSQL que puedas tener corriendo localmente (Docker u otro proyecto).
POSTGRES_PORT=5433

# Cadena de conexión que usa Prisma. Debe coincidir con las variables de
# arriba (mismo usuario, password, puerto y nombre de base de datos).
DATABASE_URL="postgresql://crm_dev_user:change_me_dev_only@localhost:5433/tuplanseguro_crm?schema=public"
